<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:Athlet" x:Class="Athlet.AppShell"
       Shell.BackgroundColor="{StaticResource Dark}" Shell.TitleColor="White" Shell.ForegroundColor="White"
       Shell.TabBarBackgroundColor="#0F1217" Shell.TabBarTitleColor="{StaticResource Accent}" Shell.TabBarUnselectedColor="{StaticResource Muted}"
       Shell.TabBarForegroundColor="{StaticResource Accent}">
  <TabBar>
    <ShellContent Title="Главная" Icon="tab_home.png" Route="home" ContentTemplate="{DataTemplate local:HomePage}"/>
    <ShellContent Title="Каталог" Icon="tab_catalog.png" Route="catalog" ContentTemplate="{DataTemplate local:CatalogPage}"/>
    <ShellContent Title="Избранное" Icon="tab_fav.png" Route="favorites" ContentTemplate="{DataTemplate local:FavoritesPage}"/>
    <ShellContent x:Name="CartTab" Title="Корзина" Icon="tab_cart.png" Route="cart" ContentTemplate="{DataTemplate local:CartPage}"/>
    <ShellContent Title="Профиль" Icon="tab_profile.png" Route="profile" ContentTemplate="{DataTemplate local:ProfilePage}"/>
  </TabBar>
</Shell>
