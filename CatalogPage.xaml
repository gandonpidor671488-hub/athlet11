<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Athlet.CatalogPage" Title="Каталог" Shell.NavBarIsVisible="False">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Padding="12,10,12,0" RowSpacing="10">
    <Label Text="Каталог" Style="{StaticResource H1}" FontSize="30"/>
    <Border Grid.Row="1" Style="{StaticResource Field}" StrokeShape="RoundRectangle 26" HeightRequest="50">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <Label Text="🔍" FontSize="18" VerticalOptions="Center"/>
        <Entry x:Name="Search" Grid.Column="1" Placeholder="Поиск по каталогу" TextChanged="OnText" VerticalOptions="Center"/>
      </Grid>
    </Border>
    <CollectionView x:Name="Cats" Grid.Row="2" HeightRequest="44" SelectionMode="Single" ItemTemplate="{StaticResource Chip}" SelectionChanged="OnCat" Margin="4,0">
      <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/></CollectionView.ItemsLayout>
    </CollectionView>
    <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="8" Margin="4,0">
      <Border Style="{StaticResource Field}" StrokeShape="RoundRectangle 23" HeightRequest="46"><Picker x:Name="SortPicker" Title="Сортировка" SelectedIndexChanged="OnFilter"/></Border>
      <Border Grid.Column="1" Style="{StaticResource Field}" StrokeShape="RoundRectangle 23" HeightRequest="46"><Picker x:Name="BrandPicker" Title="Бренд" SelectedIndexChanged="OnFilter"/></Border>
    </Grid>
    <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto" Margin="8,0" ColumnSpacing="8">
      <Switch x:Name="SaleSwitch" OnColor="{StaticResource Accent}" VerticalOptions="Center" Toggled="OnSale"/>
      <Label Grid.Column="1" Text="Только со скидкой" Style="{StaticResource MutedText}" VerticalOptions="Center"/>
      <Label x:Name="CountL" Grid.Column="2" Style="{StaticResource MutedText}" VerticalOptions="Center"/>
    </Grid>
    <CollectionView x:Name="List" Grid.Row="5" ItemTemplate="{StaticResource ProductCard}">
      <CollectionView.ItemsLayout><GridItemsLayout Orientation="Vertical" Span="2"/></CollectionView.ItemsLayout>
      <CollectionView.EmptyView>
        <VerticalStackLayout Spacing="6" Margin="0,60" HorizontalOptions="Center">
          <Label Text="🔍" FontSize="44" HorizontalOptions="Center"/>
          <Label Text="Ничего не найдено" Style="{StaticResource H2}" HorizontalOptions="Center"/>
          <Label Text="Измените фильтры или запрос" Style="{StaticResource MutedText}" HorizontalOptions="Center"/>
        </VerticalStackLayout>
      </CollectionView.EmptyView>
    </CollectionView>
  </Grid>
</ContentPage>
