<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Athlet.CheckoutPage" Title="Оформление заказа">
  <Grid RowDefinitions="*,Auto">
    <ScrollView>
      <Grid Padding="12,8,12,16">
        <VerticalStackLayout x:Name="Form" Spacing="12">

          <!-- Способ получения -->
          <Border Style="{StaticResource CardBox}" Padding="14" StrokeShape="RoundRectangle 26">
            <VerticalStackLayout Spacing="12">
              <Border BackgroundColor="#000000" Stroke="{StaticResource Line}" StrokeThickness="1" StrokeShape="RoundRectangle 22" Padding="4">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                  <RadioButton x:Name="Pickup" GroupName="m" IsChecked="True" ControlTemplate="{StaticResource SegTemplate}" CheckedChanged="OnMethod">
                    <RadioButton.Content><Label Text="Пункт выдачи" FontFamily="InterBold" FontSize="15"/></RadioButton.Content>
                  </RadioButton>
                  <RadioButton x:Name="Delivery" Grid.Column="1" GroupName="m" ControlTemplate="{StaticResource SegTemplate}" CheckedChanged="OnMethod">
                    <RadioButton.Content><Label Text="Курьер" FontFamily="InterBold" FontSize="15"/></RadioButton.Content>
                  </RadioButton>
                </Grid>
              </Border>

              <Grid x:Name="PickBox" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Label Text="📍" FontSize="20" VerticalOptions="Center"/>
                <VerticalStackLayout Grid.Column="1" Spacing="1">
                  <Label Text="ул. Спортивная, 10" Style="{StaticResource Bold}" FontSize="15"/>
                  <Label Text="Пункт выдачи ATHLET · ежедневно 9:00–21:00" Style="{StaticResource MutedText}" FontSize="12"/>
                </VerticalStackLayout>
              </Grid>

              <VerticalStackLayout x:Name="AddrBox" IsVisible="False" Spacing="6">
                <Border x:Name="AddrField" Style="{StaticResource Field}" StrokeShape="RoundRectangle 20" HeightRequest="52">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Text="📍" FontSize="18" VerticalOptions="Center"/>
                    <Entry x:Name="Address" Grid.Column="1" Placeholder="Регион, город, улица, дом, квартира" TextChanged="OnAddrChanged"/>
                  </Grid>
                </Border>
                <Border x:Name="SuggestBox" IsVisible="False" Style="{StaticResource CardBox}" StrokeShape="RoundRectangle 18" Padding="4">
                  <VerticalStackLayout x:Name="SuggestList" Spacing="0">
                    <BindableLayout.ItemTemplate>
                      <DataTemplate>
                        <Label Text="{Binding .}" FontSize="15" Padding="14,11">
                          <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnPickRegion"/></Label.GestureRecognizers>
                        </Label>
                      </DataTemplate>
                    </BindableLayout.ItemTemplate>
                  </VerticalStackLayout>
                </Border>
              </VerticalStackLayout>

              <BoxView HeightRequest="1" Color="{StaticResource Line}"/>
              <Grid ColumnDefinitions="*,Auto">
                <Label x:Name="ItemsL" Style="{StaticResource Bold}" FontSize="17"/>
                <Label x:Name="CountL" Grid.Column="1" Style="{StaticResource MutedText}" VerticalOptions="Center"/>
              </Grid>
              <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout x:Name="Thumbs" Spacing="8">
                  <BindableLayout.ItemTemplate>
                    <DataTemplate>
                      <Border WidthRequest="64" HeightRequest="76" Padding="0" StrokeShape="RoundRectangle 14" Stroke="{StaticResource Line}" StrokeThickness="1">
                        <Grid>
                          <Image Source="{Binding P.ImageSrc}" Aspect="AspectFill"/>
                          <Image Source="{Binding P.RemoteSrc}" Aspect="AspectFill"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
              </ScrollView>
            </VerticalStackLayout>
          </Border>

          <!-- Контакты -->
          <Border Style="{StaticResource CardBox}" Padding="14" StrokeShape="RoundRectangle 26">
            <VerticalStackLayout Spacing="10">
              <Label Text="Получатель" Style="{StaticResource H2}"/>
              <Border Style="{StaticResource Field}" StrokeShape="RoundRectangle 22" HeightRequest="52"><Entry x:Name="NameE" Placeholder="Ваше имя"/></Border>
              <Border Style="{StaticResource Field}" StrokeShape="RoundRectangle 22" HeightRequest="52"><Entry x:Name="Phone" Placeholder="Телефон" Keyboard="Telephone"/></Border>
            </VerticalStackLayout>
          </Border>

          <!-- Оплата -->
          <Border Style="{StaticResource CardBox}" Padding="14" StrokeShape="RoundRectangle 26">
            <VerticalStackLayout Spacing="12">
              <Label Text="Как оплатить заказ?" Style="{StaticResource H2}"/>
              <HorizontalStackLayout Spacing="10">
                <RadioButton x:Name="PayCash" GroupName="p" IsChecked="True" ControlTemplate="{StaticResource PillTemplate}">
                  <RadioButton.Content><Label Text="При получении" FontFamily="InterBold" FontSize="15"/></RadioButton.Content>
                </RadioButton>
                <RadioButton x:Name="PayCard" GroupName="p" ControlTemplate="{StaticResource PillTemplate}">
                  <RadioButton.Content><Label Text="Картой онлайн (демо)" FontFamily="InterBold" FontSize="15"/></RadioButton.Content>
                </RadioButton>
              </HorizontalStackLayout>

              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                  <Label Text="Списать бонусы" Style="{StaticResource Bold}" FontSize="16"/>
                  <Label x:Name="BonusInfo" Style="{StaticResource MutedText}" FontSize="12"/>
                </VerticalStackLayout>
                <Switch x:Name="BonusSw" Grid.Column="1" OnColor="{StaticResource Accent}" VerticalOptions="Center" Toggled="OnBonus"/>
              </Grid>
            </VerticalStackLayout>
          </Border>

          <Border Style="{StaticResource Field}" StrokeShape="RoundRectangle 22" HeightRequest="90"><Editor x:Name="Comment" Placeholder="Комментарий к заказу" AutoSize="TextChanges"/></Border>

          <HorizontalStackLayout Spacing="10">
            <Switch x:Name="RememberSw" IsToggled="True" OnColor="{StaticResource Accent}" VerticalOptions="Center"/>
            <Label Text="Запомнить данные в профиле" Style="{StaticResource MutedText}" VerticalOptions="Center"/>
          </HorizontalStackLayout>

          <!-- Итого -->
          <Border Style="{StaticResource CardBox}" Padding="14" StrokeShape="RoundRectangle 26">
            <VerticalStackLayout Spacing="8">
              <Grid ColumnDefinitions="*,Auto"><Label Text="Товары" Style="{StaticResource MutedText}"/><Label x:Name="SubL" Grid.Column="1"/></Grid>
              <Grid x:Name="DiscRow" ColumnDefinitions="*,Auto"><Label Text="Скидка" Style="{StaticResource MutedText}"/><Label x:Name="DiscL" Grid.Column="1" TextColor="{StaticResource Good}"/></Grid>
              <Grid x:Name="BonusRow" ColumnDefinitions="*,Auto"><Label Text="Оплачено бонусами" Style="{StaticResource MutedText}"/><Label x:Name="BonusL2" Grid.Column="1" TextColor="{StaticResource Good}"/></Grid>
              <Grid ColumnDefinitions="*,Auto"><Label Text="Доставка" Style="{StaticResource MutedText}"/><Label x:Name="DelL" Grid.Column="1"/></Grid>
              <Grid ColumnDefinitions="*,Auto"><Label Text="К оплате" Style="{StaticResource H2}"/><Label x:Name="TotalL" Grid.Column="1" Style="{StaticResource H2}" TextColor="{StaticResource Accent}"/></Grid>
              <Label x:Name="BonusL" Style="{StaticResource MutedText}" FontSize="12"/>
            </VerticalStackLayout>
          </Border>

          <Label x:Name="Err" TextColor="{StaticResource Danger}" FontFamily="InterBold"/>
        </VerticalStackLayout>

        <VerticalStackLayout x:Name="Done" IsVisible="False" Spacing="14" VerticalOptions="Center" Margin="0,70">
          <Label Text="✅" FontSize="72" HorizontalOptions="Center"/>
          <Label x:Name="DoneL" Style="{StaticResource H2}" HorizontalTextAlignment="Center"/>
          <Label x:Name="DoneInfo" Style="{StaticResource MutedText}" HorizontalTextAlignment="Center"/>
          <Button Text="Отследить заказ" Style="{StaticResource Btn}" Margin="0,10,0,0" Clicked="OnOrders"/>
          <Button Text="На главную" Style="{StaticResource Ghost}" Clicked="OnHome"/>
        </VerticalStackLayout>
      </Grid>
    </ScrollView>

    <Grid x:Name="ConfirmBar" Grid.Row="1" Padding="12,8,12,12" BackgroundColor="{StaticResource Dark}">
      <Button x:Name="ConfirmBtn" Style="{StaticResource Btn}" HeightRequest="58" CornerRadius="29" Clicked="OnConfirm"/>
      <Label Text="Подтвердить заказ" FontFamily="InterBold" FontSize="17" VerticalOptions="Center" Margin="26,0,0,0" InputTransparent="True"/>
      <Label x:Name="ConfirmSum" FontFamily="InterBold" FontSize="17" VerticalOptions="Center" HorizontalOptions="End" Margin="0,0,26,0" InputTransparent="True"/>
    </Grid>
  </Grid>
</ContentPage>
