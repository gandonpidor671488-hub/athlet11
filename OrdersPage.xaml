<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Athlet.OrdersPage" Title="Мои заказы">
  <CollectionView x:Name="List" Margin="12,8,12,0">
    <CollectionView.EmptyView>
      <VerticalStackLayout Spacing="8" Margin="24,90" HorizontalOptions="Center">
        <Label Text="📦" FontSize="56" HorizontalOptions="Center"/>
        <Label Text="Заказов пока нет" Style="{StaticResource H2}" HorizontalOptions="Center"/>
        <Label Text="Оформите первый заказ, он появится здесь" Style="{StaticResource MutedText}" HorizontalOptions="Center"/>
      </VerticalStackLayout>
    </CollectionView.EmptyView>
    <CollectionView.ItemTemplate>
      <DataTemplate>
        <Border Margin="0,0,0,14" Style="{StaticResource CardBox}">
          <VerticalStackLayout Spacing="12">

            <Grid ColumnDefinitions="*,Auto">
              <VerticalStackLayout Spacing="1">
                <Label Text="{Binding TitleText}" Style="{StaticResource H2}"/>
                <Label Text="{Binding DateText}" Style="{StaticResource MutedText}" FontSize="12"/>
              </VerticalStackLayout>
              <Border Grid.Column="1" Padding="10,5" StrokeShape="RoundRectangle 10" Stroke="Transparent" BackgroundColor="{Binding StatusColor}" VerticalOptions="Start">
                <Label Text="{Binding StatusText}" Style="{StaticResource Bold}" FontSize="12" TextColor="#0E1014"/>
              </Border>
            </Grid>

            <!-- Сколько осталось -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
              <Border WidthRequest="76" HeightRequest="76" StrokeShape="RoundRectangle 22" Stroke="{StaticResource Line}" StrokeThickness="1" BackgroundColor="{StaticResource Card2}">
                <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                  <Label Text="{Binding DaysNumber}" Style="{StaticResource H1}" FontSize="30" TextColor="{StaticResource Accent}" HorizontalOptions="Center"/>
                  <Label Text="{Binding DaysCaption}" Style="{StaticResource MutedText}" FontSize="12" HorizontalOptions="Center"/>
                </VerticalStackLayout>
              </Border>
              <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                <Label Text="{Binding DaysLeftText}" Style="{StaticResource Bold}" FontSize="16"/>
                <Label Text="{Binding ArrivalText}" Style="{StaticResource MutedText}" FontSize="12"/>
                <Label Text="{Binding PlaceText}" Style="{StaticResource MutedText}" FontSize="12"/>
              </VerticalStackLayout>
            </Grid>

            <Label Text="{Binding CourierText}" IsVisible="{Binding HasCourier}" TextColor="{StaticResource Gold}" FontFamily="InterBold" FontSize="13"/>
            <ProgressBar Progress="{Binding Progress}" ProgressColor="{StaticResource Accent}"/>

            <!-- Этапы -->
            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Steps}">
              <BindableLayout.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="26,*,Auto" ColumnSpacing="8">
                    <Label Text="{Binding Dot}" TextColor="{Binding DotColor}" FontFamily="InterBold" FontSize="16" HorizontalTextAlignment="Center"/>
                    <Label Grid.Column="1" Text="{Binding Title}" TextColor="{Binding TitleColor}" FontSize="14"/>
                    <Label Grid.Column="2" Text="{Binding TimeText}" Style="{StaticResource MutedText}" FontSize="12"/>
                  </Grid>
                </DataTemplate>
              </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="{StaticResource Card2}"/>
            <Label Text="{Binding Items}" Style="{StaticResource MutedText}" FontSize="13"/>
            <Label Text="{Binding BreakdownText}" Style="{StaticResource MutedText}" FontSize="11"/>
            <Grid ColumnDefinitions="*,Auto">
              <Label Text="{Binding TrackText}" Style="{StaticResource MutedText}" FontSize="12" VerticalOptions="Center"/>
              <Label Grid.Column="1" Text="{Binding TotalText}" Style="{StaticResource Price}" FontSize="20"/>
            </Grid>

            <Button Text="Показать штрихкод для получения" Style="{StaticResource Btn}" HeightRequest="48" FontSize="14" IsVisible="{Binding CanPickup}" Clicked="OnPickup"/>
            <Button Text="Я получил заказ" Style="{StaticResource Ghost}" IsVisible="{Binding CanConfirm}" Clicked="OnGot"/>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <Button Text="Повторить заказ" Style="{StaticResource Ghost}" Clicked="OnRepeat"/>
              <Button Grid.Column="1" Text="Отменить заказ" Style="{StaticResource Ghost}" TextColor="{StaticResource Danger}" IsVisible="{Binding CanCancel}" Clicked="OnCancel"/>
            </Grid>
            <Button Text="⏩ Перемотать на 1 день (демо)" Style="{StaticResource Ghost}" HeightRequest="40" FontSize="12" IsVisible="{Binding CanAccelerate}" Clicked="OnSkip"/>
          </VerticalStackLayout>
        </Border>
      </DataTemplate>
    </CollectionView.ItemTemplate>
  </CollectionView>
</ContentPage>
