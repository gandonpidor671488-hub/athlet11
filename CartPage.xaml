<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Athlet.CartPage" Title="Корзина">
  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Шапка: «Все» + удалить выбранные -->
    <Grid x:Name="HeadRow" Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16,6,16,8" IsVisible="False">
      <Border x:Name="AllBox" WidthRequest="26" HeightRequest="26" StrokeShape="RoundRectangle 8" Stroke="{StaticResource Accent}" StrokeThickness="2" Padding="0" VerticalOptions="Center">
        <Label x:Name="AllMark" FontFamily="InterBold" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center"/>
        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAll"/></Border.GestureRecognizers>
      </Border>
      <Label Grid.Column="1" Text="Все" FontSize="17" VerticalOptions="Center">
        <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnAll"/></Label.GestureRecognizers>
      </Label>
      <Label Grid.Column="2" Text="🗑" FontSize="24" VerticalOptions="Center">
        <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnClear"/></Label.GestureRecognizers>
      </Label>
    </Grid>

    <CollectionView x:Name="List" Grid.Row="1" Margin="12,0,12,0">
      <CollectionView.EmptyView>
        <VerticalStackLayout Spacing="8" Margin="24,80" HorizontalOptions="Center">
          <Label Text="🛒" FontSize="56" HorizontalOptions="Center"/>
          <Label Text="Корзина пуста" Style="{StaticResource H2}" HorizontalOptions="Center"/>
          <Label Text="Добавьте товары из каталога" Style="{StaticResource MutedText}" HorizontalOptions="Center"/>
          <Button Text="В каталог" Style="{StaticResource Btn}" Margin="0,12,0,0" Clicked="OnCatalog"/>
        </VerticalStackLayout>
      </CollectionView.EmptyView>
      <CollectionView.ItemTemplate>
        <DataTemplate>
          <Border Margin="0,0,0,10" Padding="10" StrokeShape="RoundRectangle 22" Stroke="{StaticResource Line}" StrokeThickness="1" Background="{StaticResource CardBrush}">
            <Grid ColumnDefinitions="Auto,92,*" ColumnSpacing="10">
              <Border WidthRequest="26" HeightRequest="26" StrokeShape="RoundRectangle 8" Stroke="{StaticResource Accent}" StrokeThickness="2" Padding="0" VerticalOptions="Start" Margin="0,2,0,0" BackgroundColor="{Binding CheckBg}">
                <Label Text="{Binding CheckMark}" FontFamily="InterBold" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center"/>
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCheck"/></Border.GestureRecognizers>
              </Border>
              <Border Grid.Column="1" WidthRequest="92" HeightRequest="92" Padding="0" StrokeShape="RoundRectangle 14" Stroke="Transparent" VerticalOptions="Start">
                <Grid>
                  <Image Source="{Binding P.ImageSrc}" Aspect="AspectFill"/>
                  <Image Source="{Binding P.RemoteSrc}" Aspect="AspectFill"/>
                </Grid>
              </Border>
              <VerticalStackLayout Grid.Column="2" Spacing="3">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <VerticalStackLayout Spacing="0">
                    <Label Text="{Binding SumText}" Style="{StaticResource Price}" FontSize="19"/>
                    <Label Text="{Binding OldSumText}" Style="{StaticResource OldPrice}"/>
                  </VerticalStackLayout>
                  <HorizontalStackLayout Grid.Column="1" Spacing="14" VerticalOptions="Start">
                    <Label Text="♡" FontSize="22" TextColor="{StaticResource Muted}"><Label.GestureRecognizers><TapGestureRecognizer Tapped="OnToFav"/></Label.GestureRecognizers></Label>
                    <Label Text="🗑" FontSize="20"><Label.GestureRecognizers><TapGestureRecognizer Tapped="OnDel"/></Label.GestureRecognizers></Label>
                  </HorizontalStackLayout>
                </Grid>
                <Label Text="{Binding P.Name}" Style="{StaticResource Bold}" FontSize="14" MaxLines="2" LineBreakMode="TailTruncation"/>
                <Label Text="{Binding FlavorText}" Style="{StaticResource MutedText}" FontSize="12"/>
                <HorizontalStackLayout Spacing="10" Margin="0,4,0,0">
                  <Button Text="−" Style="{StaticResource Mini}" Clicked="OnMinus"/>
                  <Label Text="{Binding Qty}" FontFamily="InterBold" FontSize="16" VerticalOptions="Center"/>
                  <Button Text="+" Style="{StaticResource Mini}" Clicked="OnPlus"/>
                </HorizontalStackLayout>
              </VerticalStackLayout>
            </Grid>
          </Border>
        </DataTemplate>
      </CollectionView.ItemTemplate>

      <!-- Итоги, промокод и шкала бесплатной доставки -->
      <CollectionView.Footer>
        <Border x:Name="FooterBox" Style="{StaticResource CardBox}" Padding="14" Margin="0,2,0,14">
          <VerticalStackLayout Spacing="9">
            <Label x:Name="FreeL" Style="{StaticResource MutedText}"/>
            <ProgressBar x:Name="FreeBar" ProgressColor="{StaticResource Accent}"/>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <Border Style="{StaticResource Field}" BackgroundColor="{StaticResource Card2}" HeightRequest="44"><Entry x:Name="PromoEntry" Placeholder="Промокод" Keyboard="Text"/></Border>
              <Button Grid.Column="1" Text="Применить" Style="{StaticResource Ghost}" HeightRequest="44" Clicked="OnPromo"/>
            </Grid>
            <HorizontalStackLayout Spacing="8">
              <Border Style="{StaticResource PromoChip}"><Label Text="ATHLET10" FontFamily="InterBold" FontSize="12"/><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChip"/></Border.GestureRecognizers></Border>
              <Border Style="{StaticResource PromoChip}"><Label Text="FIT15" FontFamily="InterBold" FontSize="12"/><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChip"/></Border.GestureRecognizers></Border>
              <Border Style="{StaticResource PromoChip}"><Label Text="WELCOME" FontFamily="InterBold" FontSize="12"/><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChip"/></Border.GestureRecognizers></Border>
            </HorizontalStackLayout>
            <Label x:Name="PromoMsg" FontSize="12"/>

            <Grid ColumnDefinitions="*,Auto"><Label Text="Товары" Style="{StaticResource MutedText}"/><Label x:Name="SubL" Grid.Column="1" Style="{StaticResource Bold}"/></Grid>
            <Grid x:Name="SaveRow" ColumnDefinitions="*,Auto"><Label Text="Скидки на товары" Style="{StaticResource MutedText}"/><Label x:Name="SaveL" Grid.Column="1" Style="{StaticResource Bold}" TextColor="{StaticResource Good}"/></Grid>
            <Grid x:Name="DiscRow" ColumnDefinitions="*,Auto"><Label Text="Промокод" Style="{StaticResource MutedText}"/><Label x:Name="DiscL" Grid.Column="1" Style="{StaticResource Bold}" TextColor="{StaticResource Good}"/></Grid>
            <Grid ColumnDefinitions="*,Auto"><Label Text="Итого" Style="{StaticResource H2}"/><Label x:Name="TotalL" Grid.Column="1" Style="{StaticResource H2}" TextColor="{StaticResource Accent}"/></Grid>
            <Label x:Name="EtaL" Style="{StaticResource MutedText}" FontSize="12"/>
          </VerticalStackLayout>
        </Border>
      </CollectionView.Footer>
    </CollectionView>

    <!-- Нижняя оранжевая кнопка -->
    <Border Grid.Row="2" BackgroundColor="{StaticResource Dark}" Stroke="Transparent" Padding="14,8,14,12">
      <Border x:Name="CheckoutBtn" HeightRequest="56" Padding="22,0" StrokeShape="RoundRectangle 28" Stroke="Transparent" Background="{StaticResource HeroBrush}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <Label x:Name="CheckoutL" FontFamily="InterBold" FontSize="17" VerticalOptions="Center"/>
          <Label x:Name="CheckoutSum" Grid.Column="1" FontFamily="InterBold" FontSize="17" VerticalOptions="Center"/>
        </Grid>
        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCheckout"/></Border.GestureRecognizers>
      </Border>
    </Border>
  </Grid>
</ContentPage>
