<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Athlet.CartPage" Title="Корзина">
  <ContentPage.ToolbarItems>
    <ToolbarItem Text="Очистить" Clicked="OnClear"/>
  </ContentPage.ToolbarItems>
  <Grid RowDefinitions="*,Auto">
    <CollectionView x:Name="List" Margin="10,6,10,0">
      <CollectionView.Header>
        <Border Style="{StaticResource CardBox}" Padding="14,12" Margin="0,0,0,10" StrokeShape="RoundRectangle 20">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Label Text="📍" FontSize="20" VerticalOptions="Center"/>
            <VerticalStackLayout Grid.Column="1" Spacing="1">
              <Label Text="Адрес доставки" Style="{StaticResource MutedText}" FontSize="12"/>
              <Label x:Name="AddrL" Style="{StaticResource Bold}" FontSize="15" LineBreakMode="TailTruncation"/>
            </VerticalStackLayout>
          </Grid>
        </Border>
      </CollectionView.Header>
      <CollectionView.EmptyView>
        <VerticalStackLayout Spacing="8" Margin="24,80" HorizontalOptions="Center">
          <Label Text="🛒" FontSize="56" HorizontalOptions="Center"/>
          <Label Text="Корзина пуста" Style="{StaticResource H2}" HorizontalOptions="Center"/>
          <Label Text="Добавьте товары из каталога" Style="{StaticResource MutedText}" HorizontalOptions="Center"/>
          <Button Text="В каталог" Style="{StaticResource Btn}" Margin="0,12,0,0" Clicked="OnCatalog"/>
        </VerticalStackLayout>
      </CollectionView.EmptyView>
      <CollectionView.ItemTemplate>
        <DataTemplate>
          <Border Margin="0,0,0,10" Padding="10" StrokeShape="RoundRectangle 26" Stroke="{StaticResource Line}" StrokeThickness="1" Background="{StaticResource CardBrush}">
            <Grid ColumnDefinitions="104,*" ColumnSpacing="12">
              <Border WidthRequest="104" HeightRequest="132" Padding="0" StrokeShape="RoundRectangle 18" Stroke="Transparent" VerticalOptions="Start">
                <Grid>
                  <Image Source="{Binding P.ImageSrc}" Aspect="AspectFill"/>
                  <Image Source="{Binding P.RemoteSrc}" Aspect="AspectFill"/>
                </Grid>
              </Border>
              <VerticalStackLayout Grid.Column="1" Spacing="3">
                <HorizontalStackLayout Spacing="8">
                  <Label Text="{Binding SumText}" TextColor="{StaticResource Accent}" FontFamily="InterBold" FontSize="21"/>
                  <Label Text="{Binding OldSumText}" Style="{StaticResource OldPrice}" VerticalOptions="End" Margin="0,0,0,3"/>
                </HorizontalStackLayout>
                <Label Text="{Binding P.Name}" FontSize="14" MaxLines="2" LineBreakMode="TailTruncation"/>
                <Label Text="{Binding FlavorText}" Style="{StaticResource MutedText}" FontSize="12"/>
                <Label Text="Самовывоз завтра" Style="{StaticResource Bold}" FontSize="13"/>
                <Label Text="● В наличии" TextColor="{StaticResource Good}" FontSize="12"/>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,6,0,0">
                  <Border StrokeShape="RoundRectangle 20" Stroke="Transparent" BackgroundColor="{StaticResource Card2}" Padding="4,0">
                    <HorizontalStackLayout Spacing="2">
                      <Label Text="🗑" FontSize="18" VerticalOptions="Center" Margin="10,0,2,0">
                        <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnDel"/></Label.GestureRecognizers>
                      </Label>
                      <Button Text="−" Style="{StaticResource Mini}" BackgroundColor="Transparent" TextColor="{StaticResource Accent}" Clicked="OnMinus"/>
                      <Label Text="{Binding Qty}" FontFamily="InterBold" FontSize="16" VerticalOptions="Center" WidthRequest="20" HorizontalTextAlignment="Center"/>
                      <Button Text="+" Style="{StaticResource Mini}" BackgroundColor="Transparent" TextColor="{StaticResource Accent}" Clicked="OnPlus"/>
                    </HorizontalStackLayout>
                  </Border>
                  <Border Grid.Column="1" StrokeShape="RoundRectangle 20" Stroke="Transparent" BackgroundColor="{StaticResource Card2}" HeightRequest="42">
                    <Label Text="♡ В избранное" FontFamily="InterBold" FontSize="13" TextColor="{StaticResource Accent}" HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnToFav"/></Border.GestureRecognizers>
                  </Border>
                </Grid>
              </VerticalStackLayout>
            </Grid>
          </Border>
        </DataTemplate>
      </CollectionView.ItemTemplate>
      <CollectionView.Footer>
        <VerticalStackLayout Spacing="10" Margin="0,4,0,16">
          <Border Style="{StaticResource CardBox}" Padding="14">
            <VerticalStackLayout Spacing="9">
              <Label x:Name="FreeL" Style="{StaticResource MutedText}"/>
              <ProgressBar x:Name="FreeBar" ProgressColor="{StaticResource Accent}"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                <Border Style="{StaticResource Field}" BackgroundColor="{StaticResource Card2}" StrokeShape="RoundRectangle 22" HeightRequest="44"><Entry x:Name="PromoEntry" Placeholder="Промокод" Keyboard="Text"/></Border>
                <Button Grid.Column="1" Text="Применить" Style="{StaticResource Ghost}" HeightRequest="44" Clicked="OnPromo"/>
              </Grid>
              <HorizontalStackLayout Spacing="8">
                <Border Style="{StaticResource PromoChip}"><Label Text="ATHLET10" FontFamily="InterBold" FontSize="12"/><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChip"/></Border.GestureRecognizers></Border>
                <Border Style="{StaticResource PromoChip}"><Label Text="FIT15" FontFamily="InterBold" FontSize="12"/><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChip"/></Border.GestureRecognizers></Border>
                <Border Style="{StaticResource PromoChip}"><Label Text="WELCOME" FontFamily="InterBold" FontSize="12"/><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChip"/></Border.GestureRecognizers></Border>
              </HorizontalStackLayout>
              <Label x:Name="PromoMsg" FontSize="12"/>
            </VerticalStackLayout>
          </Border>
          <Border Style="{StaticResource CardBox}" Padding="14">
            <VerticalStackLayout Spacing="9">
              <Grid ColumnDefinitions="*,Auto"><Label Text="Товары" Style="{StaticResource MutedText}"/><Label x:Name="SubL" Grid.Column="1" Style="{StaticResource Bold}"/></Grid>
              <Grid x:Name="SaveRow" ColumnDefinitions="*,Auto"><Label Text="Скидки на товары" Style="{StaticResource MutedText}"/><Label x:Name="SaveL" Grid.Column="1" Style="{StaticResource Bold}" TextColor="{StaticResource Good}"/></Grid>
              <Grid x:Name="DiscRow" ColumnDefinitions="*,Auto"><Label Text="Промокод" Style="{StaticResource MutedText}"/><Label x:Name="DiscL" Grid.Column="1" Style="{StaticResource Bold}" TextColor="{StaticResource Good}"/></Grid>
              <Grid ColumnDefinitions="*,Auto"><Label Text="Итого" Style="{StaticResource H2}"/><Label x:Name="TotalL" Grid.Column="1" Style="{StaticResource H2}" TextColor="{StaticResource Accent}"/></Grid>
              <Label x:Name="EtaL" Style="{StaticResource MutedText}" FontSize="12"/>
            </VerticalStackLayout>
          </Border>
        </VerticalStackLayout>
      </CollectionView.Footer>
    </CollectionView>

    <Grid Grid.Row="1" Padding="12,8,12,12" BackgroundColor="{StaticResource Dark}">
      <Button x:Name="Checkout" Style="{StaticResource Btn}" HeightRequest="58" CornerRadius="29" Clicked="OnCheckout"/>
      <Label x:Name="CheckL" FontFamily="InterBold" FontSize="17" VerticalOptions="Center" Margin="26,0,0,0" InputTransparent="True"/>
      <Label x:Name="CheckSum" FontFamily="InterBold" FontSize="17" VerticalOptions="Center" HorizontalOptions="End" Margin="0,0,26,0" InputTransparent="True"/>
    </Grid>
  </Grid>
</ContentPage>
