<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Athlet.FavoritesPage" Title="Избранное">
  <CollectionView x:Name="List" ItemTemplate="{StaticResource ProductCard}" Margin="8,6,8,0">
    <CollectionView.ItemsLayout><GridItemsLayout Orientation="Vertical" Span="2"/></CollectionView.ItemsLayout>
    <CollectionView.EmptyView>
      <VerticalStackLayout Spacing="8" Margin="24,90" HorizontalOptions="Center">
        <Label Text="♡" FontSize="64" TextColor="#FF4D6A" HorizontalOptions="Center"/>
        <Label Text="Пока пусто" Style="{StaticResource H2}" HorizontalOptions="Center"/>
        <Label Text="Нажмите на сердечко на карточке товара, чтобы сохранить его здесь" Style="{StaticResource MutedText}" HorizontalTextAlignment="Center"/>
        <Button Text="Перейти в каталог" Style="{StaticResource Btn}" Margin="0,12,0,0" Clicked="OnCatalog"/>
      </VerticalStackLayout>
    </CollectionView.EmptyView>
  </CollectionView>
</ContentPage>
